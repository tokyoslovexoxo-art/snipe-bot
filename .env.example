# ==== Safety switch ====
# Keep this "true" until you have watched the bot run for a while in dry-run
# and are comfortable with its behavior. Only set to "false" to trade real SOL.
DRY_RUN=true

# ==== Wallet / RPC (required for DRY_RUN=false) ====
# Base58-encoded Solana secret key (e.g. the array a Phantom/Solflare export
# gives you, converted to base58, or output of `solana-keygen`/bs58 encode).
# NEVER commit this file. .env is gitignored on purpose.
PRIVATE_KEY=
# Use a low-latency paid RPC (Helius, QuickNode, Triton, etc.) for live
# trading. Public RPCs are too slow/rate-limited to snipe competitively.
RPC_URL=https://api.mainnet-beta.solana.com

# ==== Paper trading ====
# Starting virtual SOL balance used only when DRY_RUN=true.
DRY_RUN_STARTING_BALANCE_SOL=10

# ==== Strategy parameters ====
# SOL spent per snipe.
BUY_AMOUNT_SOL=1
# Flat take-profit percent — only used if DYNAMIC_TAKE_PROFIT_ENABLED=false
# (see the Dynamic take-profit section below for the default behavior).
TAKE_PROFIT_PCT=20
# Sell when unrealized loss reaches this percent.
STOP_LOSS_PCT=10

# ==== Entry gate ====
# How a new token qualifies for a buy:
#   market_cap - buy the instant market cap is within
#                [ENTRY_MIN_MARKET_CAP_USD, ENTRY_MAX_MARKET_CAP_USD], no
#                volume wait at all. This is the "buy in at 2.5k-4k mcap the
#                second it launches" behavior.
#   volume     - original behavior: wait for MIN_VOLUME_SOL of cumulative
#                bonding-curve buys within VOLUME_WINDOW_MS.
#   both       - require both conditions at once.
ENTRY_FILTER_MODE=market_cap
# USD market-cap range for "market_cap"/"both" modes.
ENTRY_MIN_MARKET_CAP_USD=2500
ENTRY_MAX_MARKET_CAP_USD=4000
# Minimum cumulative SOL bought on the bonding curve (since token creation)
# before we'll buy in. Only used by "volume"/"both" modes.
MIN_VOLUME_SOL=0.2
# How long (ms) we watch a new token before giving up on it if it never
# qualifies (never reaches the market-cap range, and/or never crosses
# MIN_VOLUME_SOL, depending on ENTRY_FILTER_MODE).
VOLUME_WINDOW_MS=60000
# Max number of open positions at once (caps total SOL at risk).
MAX_CONCURRENT_POSITIONS=3
# Hard time-based exit safety net: force-sell a position after this long even
# if TP/SL wasn't hit (protects against a token going illiquid/dead).
MAX_HOLD_TIME_MS=600000
# Anti-rug filter: skip tokens where the creator's own initial buy is more
# than this percent of the bonding curve's token supply at creation. Note:
# a PRIORITY_SNIPER_WALLETS buy overrides this filter (see below) — that's
# an intentional, explicit override you asked for, not a bug.
MAX_DEV_HOLD_PCT=30
# Slippage tolerance passed to the trade builder, in percent.
SLIPPAGE_PCT=10
# Priority fee (SOL) added to transactions to help win the race for inclusion.
PRIORITY_FEE_SOL=0.0005
# Higher priority fee (SOL), live mode only, used instead of PRIORITY_FEE_SOL
# specifically when a buy is triggered by copying a PRIORITY_SNIPER_WALLETS
# wallet. This is a fast-follow, NOT front-running: PumpPortal's feed only
# reports trades that already landed on-chain, so there is no pending
# transaction of theirs to beat — this just helps our own copy-trade confirm
# sooner, since other bots may be racing to copy the same wallet.
PRIORITY_WALLET_FOLLOW_FEE_SOL=0.002
# Which pool/venue to trade on via PumpPortal ("pump" = pump.fun bonding curve).
POOL=pump

# ==== Logging ====
LOG_FILE=trades.jsonl

# ==== Dev reputation tracking ====
# Remembers creator wallets across restarts (data/devs.json). Devs with a
# poor track record get blacklisted (skipped); devs with a strong track
# record get fast-tracked (bought immediately, no volume wait).
DEV_TRACKING_ENABLED=true
DEV_STORE_FILE=data/devs.json
# A dev needs at least this many resolved (bought) trades before being
# classified as trusted or blacklisted at all.
TRUST_MIN_SAMPLES=2
TRUST_MIN_WIN_RATE_PCT=60
BLACKLIST_MIN_SAMPLES=2
BLACKLIST_MAX_WIN_RATE_PCT=25

# ==== Adaptive filter tuning ====
# After every TUNING_WINDOW_TRADES closed trades, nudges MIN_VOLUME_SOL and
# MAX_DEV_HOLD_PCT tighter or looser based on realized win rate, never more
# than TUNING_MAX_ADJUST_PCT away from the baselines above. Does NOT touch
# TAKE_PROFIT_PCT/STOP_LOSS_PCT. Also nudges the ENTRY_MIN/MAX_MARKET_CAP_USD
# range's center toward what a PRIORITY_SNIPER_WALLETS wallet actually buys
# at, once it has at least 3 observed buys. Bounded the same way as every
# other tuned value. State persists in data/tuning.json.
ADAPTIVE_TUNING_ENABLED=true
TUNING_STORE_FILE=data/tuning.json
TUNING_WINDOW_TRADES=20
TUNING_MAX_ADJUST_PCT=40

# ==== Sniper (other buyer wallet) reputation tracking ====
# Watches OTHER wallets (not the creator) buying/selling on tokens we're
# already watching, and scores them on realized round-trip PnL for the
# portion of their trading we actually observe (data/snipers.json). If a
# trusted sniper buys into a token we're tracking, that fast-tracks a buy —
# same mechanism as the dev-trust fast-track.
SNIPER_TRACKING_ENABLED=true
SNIPER_STORE_FILE=data/snipers.json
# "Really profitable all the time" is a high bar by design.
SNIPER_TRUST_MIN_SAMPLES=3
SNIPER_TRUST_MIN_WIN_RATE_PCT=80
# Manually seed specific wallet(s) as trusted immediately, comma-separated,
# e.g. one you've observed being consistently profitable elsewhere. Trusted
# "until proven otherwise": once we've actually observed enough of their own
# round-trips and their real performance is bad, the free pass is revoked.
# These wallets get extra treatment beyond normal sniper-trust fast-tracking:
#  - Their buy overrides the anti-rug filter (MAX_DEV_HOLD_PCT/blacklist) —
#    the bot buys the same coin even if it would otherwise have been skipped.
#  - Every observed buy's situation (market cap, dev-hold%, time since
#    launch) is recorded (data/snipers.json) and its running averages feed
#    back into the adaptive tuner (see below), which is the "figure out why
#    this wallet picks what it picks and build off that" mechanism.
#  - In live mode, copy-trade buys triggered by this wallet use
#    PRIORITY_WALLET_FOLLOW_FEE_SOL above instead of PRIORITY_FEE_SOL.
PRIORITY_SNIPER_WALLETS=5brv79eFZ2rGprXNvqgVJBkBptkkw8GJX1XydJyZLyAr
SNIPER_REVOKE_MIN_SAMPLES=3
SNIPER_REVOKE_MAX_WIN_RATE_PCT=40

# ==== Copy-trade-only mode ====
# When true (the default), the bot buys ONLY when a PRIORITY_SNIPER_WALLETS
# wallet buys — ENTRY_FILTER_MODE (market_cap/volume) and the dev-trust /
# earned-trust-sniper fast-tracks are all disabled. This is pure copy-
# trading of the specific wallet(s) above, matching their own quick-in/
# quick-out style. Set to false to go back to the bot judging launches on
# its own (market-cap-range) signals instead.
COPY_TRADE_ONLY_MODE=true
# How long (ms) a new token stays watched, waiting for a priority wallet's
# buy, before giving up. Only used in copy-trade-only mode.
COPY_TRADE_WATCH_WINDOW_MS=300000
# Once a priority wallet has this many observed buy+sell pairs, a position
# copying that wallet targets closing at this percent of the wallet's own
# average hold time (time from launch to their sell) — e.g. 85 means aim to
# be out a bit before they typically are, based on real observed pattern.
# This is NOT knowledge of a pending sell of theirs (impossible — see
# README); it's a bet on their historical behavior, which can be wrong on
# any single trade. The take-profit target also switches to that wallet's
# own observed average multiple (avg sell mcap / avg buy mcap, clamped to
# [MIN_TAKE_PROFIT_PCT, MAX_TAKE_PROFIT_PCT]) once enough samples exist,
# instead of the generic confidence-based target.
PREEMPTIVE_EXIT_FRACTION_PCT=85
PREEMPTIVE_EXIT_MIN_SAMPLES=3

# ==== Dynamic take-profit ====
# Instead of a flat TAKE_PROFIT_PCT, place the take-profit target somewhere
# in [MIN_TAKE_PROFIT_PCT, MAX_TAKE_PROFIT_PCT] based on a deterministic
# confidence score from this trade's dev/sniper trust signals (see
# src/confidence.ts — not a black-box model, see README). While a trusted
# sniper is confirmed still holding the same token, the bot keeps aiming for
# that higher target; if one was holding and fully exits, the bar drops back
# to MIN_TAKE_PROFIT_PCT so a real gain gets taken instead of round-tripping.
DYNAMIC_TAKE_PROFIT_ENABLED=true
# 50-100% matches "sell for 1.5x-2x" — tightened from an earlier 50-150%
# default now that copy-trade-only mode (above) is the default strategy.
MIN_TAKE_PROFIT_PCT=50
MAX_TAKE_PROFIT_PCT=100
# If a trusted sniper backing this trade fully exits, follow them out
# immediately regardless of current PnL (only applies while dynamic TP is on).
SNIPER_EXIT_ENABLED=true
# Shorter hold cap that applies once no trusted sniper is currently holding
# the token (whether one ever was or not) — keeps a position from sitting
# around for the full MAX_HOLD_TIME_MS chasing a big target with no
# corroborating signal present right now. Always <= MAX_HOLD_TIME_MS.
UNSUPPORTED_MAX_HOLD_MS=180000

# Manually-set SOL/USD rate used for the ENTRY_MIN/MAX_MARKET_CAP_USD gate
# and buy-context logging above. NOT a live price feed — SOL is volatile,
# keep this reasonably current yourself. ~$76 as of when this was configured
# (Jul 2026).
SOL_USD_PRICE=76

# ==== Status snapshot ====
# The bot writes a small snapshot of its live state here periodically, for
# the dashboard (below) to read. Not used for anything trading-related.
STATUS_FILE=data/status.json

# ==== Web dashboard (npm run dashboard) ====
# A separate, read-only status page protected by HTTP Basic Auth — a
# username/password prompt your browser shows natively. Runs as its own
# process, independent of the bot; only ever reads STATUS_FILE/LOG_FILE.
# CHANGE THESE — do not leave placeholders, and do not commit real values
# here (.env.example is tracked in git; your real .env is not).
DASHBOARD_USERNAME=changeme
DASHBOARD_PASSWORD=changeme
DASHBOARD_PORT=3000
